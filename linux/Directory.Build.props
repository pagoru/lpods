<Project>
  <!-- Linux build. Replaces the repository's Directory.Build.props (net10.0-windows, win-x64), which is not imported. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Upstream sources, compiled as links. -->
    <UpstreamDir>$(MSBuildThisFileDirectory)..\src\WPods\</UpstreamDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Linux only (BlueZ, glibc, PipeWire). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
